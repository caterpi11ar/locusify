{
  "name": "locusify",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "dev:app": "pnpm --filter @locusify/app dev",
    "dev:web": "pnpm --filter @locusify/web dev",
    "dev:backend": "pnpm --filter @locusify/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "vercel:check": "node scripts/vercel.mjs check",
    "vercel:status": "node scripts/vercel.mjs status",
    "vercel:list": "node scripts/vercel.mjs list"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@vercel/sdk": "^1.19.40",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "catalog:"
  }
}
