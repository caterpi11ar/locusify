{
  "name": "locusify",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "dev:app": "pnpm --filter @locusify/app dev",
    "dev:web": "pnpm --filter @locusify/web dev",
    "dev:backend": "pnpm --filter @locusify/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "vercel:check": "node scripts/vercel.mjs check",
    "vercel:status": "node scripts/vercel.mjs status",
    "vercel:list": "node scripts/vercel.mjs list",
    "verify": "bash tools/verify/run.sh",
    "verify:auth": "bash tools/verify/run-auth.sh",
    "verify:edge": "bash tools/verify/run-edge.sh",
    "verify:all": "bash tools/verify/run-all.sh",
    "report": "python3 tools/verify/report.py",
    "audit:ui": "python3 tools/verify/audit-ui.py --base http://localhost:1052"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "~9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@vercel/sdk": "^1.28.41",
    "eslint": "^9",
    "html-to-image": "^1.11.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "catalog:"
  }
}
