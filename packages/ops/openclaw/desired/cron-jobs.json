{
  "version": 1,
  "jobs": [
    {
      "name": "locusify-xhs-daily-ops",
      "description": "每天自动分层汇总运营上下文，只读同步小红书数据，由三角色 Team 决策；每个成功 Run 必须执行至少一个有意义的批准动作，并自动执行通过质量门禁的批准动作",
      "agent": "xhs-ops",
      "schedule": {
        "kind": "cron",
        "expression": "0 9 * * *",
        "timezone": "Asia/Shanghai",
        "exact": true
      },
      "session": "isolated",
      "timeoutSeconds": 1500,
      "expectFinal": true,
      "enabledOnImport": false,
      "payload": {
        "kind": "command",
        "argv": [
          "sh",
          "packages/ops/scripts/run-xhs-daily-ops.sh"
        ],
        "cwd": "${LOCUSIFY_REPO_ROOT}",
        "env": {
          "LOCUSIFY_XHS_RUN_TIMEOUT_SECONDS": "1500"
        },
        "noOutputTimeoutSeconds": 90,
        "outputMaxBytes": 65536
      },
      "requiredSkill": "locusify-xhs-daily-ops",
      "requiredMcp": "xiaohongshu"
    }
  ]
}
